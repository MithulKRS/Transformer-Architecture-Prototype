import numpy as np
import tensorflow as tf
from tensorflow.keras import layers, Model
from sklearn.metrics import precision_score, recall_score, f1_score, average_precision_score
from sklearn.model_selection import train_test_split


# ==========================================
# 1. Synthetic "Alaska" Data Generator
# ==========================================
def generate_synthetic_alaska_data(num_samples=1000, lookback=6, height=16, width=16, channels=5):
    """
    Simulates spatiotemporal satellite and weather data.
    Channels: [NDVI, SAR_Moisture, Temp, Wind_Speed, Humidity]
    Outputs a highly imbalanced dataset (e.g., ~10% fire risk patches).
    """
    print("Generating synthetic spatiotemporal tensors...")
    # Shape: (Samples, Time, Height, Width, Channels)
    X = np.random.rand(num_samples, lookback, height, width, channels).astype(np.float32)
    
    # Simulate fire logic: High temp + High wind + Low moisture + High NDVI = Fire
    # We create a synthetic baseline rule to generate ground truth labels
    y = np.zeros((num_samples, 1), dtype=np.float32)
    for i in range(num_samples):
        # Look at the most recent time step (t = -1)
        recent_temp = np.mean(X[i, -1, :, :, 2])
        recent_wind = np.mean(X[i, -1, :, :, 3])
        recent_moisture = np.mean(X[i, -1, :, :, 1])
        
        # Artificial threshold for ignition
        if recent_temp > 0.7 and recent_wind > 0.6 and recent_moisture < 0.3:
            y[i] = 1.0 # Fire occurs
            
    # Add some random noise to make the task harder
    flip_indices = np.random.choice(num_samples, size=int(num_samples*0.05), replace=False)
    y[flip_indices] = 1.0 - y[flip_indices]
    
    print(f"Dataset generated. Shape: {X.shape}")
    print(f"Class Distribution: {np.sum(y)} Fires, {len(y) - np.sum(y)} Non-Fires")
    return X, y

# ==========================================
# 2. Hybrid CNN-Transformer Architecture
# ==========================================
class TransformerEncoderBlock(layers.Layer):
    """Temporal self-attention block."""
    def __init__(self, embed_dim, num_heads, ff_dim, rate=0.1, **kwargs):
        super(TransformerEncoderBlock, self).__init__(**kwargs)
        self.att = layers.MultiHeadAttention(num_heads=num_heads, key_dim=embed_dim)
        self.ffn = tf.keras.Sequential([
            layers.Dense(ff_dim, activation="relu"),
            layers.Dense(embed_dim)
        ])
        self.layernorm1 = layers.LayerNormalization(epsilon=1e-6)
        self.layernorm2 = layers.LayerNormalization(epsilon=1e-6)
        self.dropout1 = layers.Dropout(rate)
        self.dropout2 = layers.Dropout(rate)

    def call(self, inputs, training=False):
        attn_output = self.att(inputs, inputs)
        attn_output = self.dropout1(attn_output, training=training)
        out1 = self.layernorm1(inputs + attn_output)
        ffn_output = self.ffn(out1)
        ffn_output = self.dropout2(ffn_output, training=training)
        return self.layernorm2(out1 + ffn_output)

def build_hybrid_fire_model(lookback, height, width, channels):
    """
    Fuses a TimeDistributed CNN (Spatial) with a Transformer (Temporal).
    """
    inputs = layers.Input(shape=(lookback, height, width, channels))
    
    # --- Spatial Encoding (CNN applied to each time step) ---
    # TimeDistributed applies the same Conv2D to every month in the sequence
    x = layers.TimeDistributed(layers.Conv2D(16, (3, 3), activation='relu', padding='same'))(inputs)
    x = layers.TimeDistributed(layers.MaxPooling2D((2, 2)))(x)
    x = layers.TimeDistributed(layers.Conv2D(32, (3, 3), activation='relu', padding='same'))(x)
    x = layers.TimeDistributed(layers.GlobalAveragePooling2D())(x)
    
    # Now x is shaped (Batch, Time, Spatial_Features). Example: (Batch, 6, 32)
    embed_dim = 32
    
    # --- Temporal Encoding (Transformer) ---
    # Add trainable positional encodings for the temporal dimension
    positions = tf.range(start=0, limit=lookback, delta=1)
    pos_embeddings = layers.Embedding(input_dim=lookback, output_dim=embed_dim)(positions)
    x = x + pos_embeddings
    
    # Pass through Transformer blocks
    x = TransformerEncoderBlock(embed_dim=embed_dim, num_heads=4, ff_dim=64)(x)
    x = TransformerEncoderBlock(embed_dim=embed_dim, num_heads=4, ff_dim=64)(x)
    
    # Extract the representation of the most recent time step to predict the future
    x = layers.Lambda(lambda tensor: tensor[:, -1, :])(x)
    
    # --- Prediction Head ---
    x = layers.Dense(32, activation="relu")(x)
    x = layers.Dropout(0.3)(x)
    outputs = layers.Dense(1, activation="sigmoid")(x)
    
    model = tf.keras.Model(inputs=inputs, outputs=outputs, name="Hybrid_Fire_Guardian")
    return model

# ==========================================
# 3. Execution & Evaluation Pipeline
# ==========================================
if __name__ == "__main__":
    # Hyperparameters
    LOOKBACK = 6      # e.g., 6 months of historical data
    GRID_SIZE = 16    # 16x16 pixel spatial patch
    CHANNELS = 5      # Multimodal features
    BATCH_SIZE = 32
    EPOCHS = 10
    
    # 1. Prepare Data
    X_full, y_full = generate_synthetic_alaska_data(
        num_samples=2000, lookback=LOOKBACK, height=GRID_SIZE, width=GRID_SIZE, channels=CHANNELS
    )
    X_train, X_test, y_train, y_test = train_test_split(X_full, y_full, test_size=0.2, random_state=42, stratify=y_full)
    
    # Calculate class weights to handle severe fire imbalance
    neg, pos = np.bincount(y_train.flatten().astype(int))
    total = neg + pos
    weight_for_0 = (1 / neg) * (total / 2.0)
    weight_for_1 = (1 / pos) * (total / 2.0)
    class_weights = {0: weight_for_0, 1: weight_for_1}
    print(f"\nClass Weights applied: {class_weights}")

    # 2. Build and Compile Model
    model = build_hybrid_fire_model(LOOKBACK, GRID_SIZE, GRID_SIZE, CHANNELS)
    
    # Using AUC(curve='PR') natively in TF to track precision-recall during training
    model.compile(
        optimizer=tf.keras.optimizers.Adam(learning_rate=1e-3),
        loss=tf.keras.losses.BinaryCrossentropy(),
        metrics=[tf.keras.metrics.AUC(curve='PR', name='pr_auc'), 'accuracy']
    )
    
    # 3. Train the Prototype
    print("\nStarting Training Phase...")
    history = model.fit(
        X_train, y_train,
        batch_size=BATCH_SIZE,
        epochs=EPOCHS,
        validation_split=0.2,
        class_weight=class_weights,
        verbose=1
    )
    
    # 4. Strict Evaluation
    print("\n--- Final Model Evaluation ---")
    predictions_prob = model.predict(X_test)
    predictions_binary = (predictions_prob > 0.5).astype(int)
    
    precision = precision_score(y_test, predictions_binary, zero_division=0)
    recall = recall_score(y_test, predictions_binary, zero_division=0)
    f1 = f1_score(y_test, predictions_binary, zero_division=0)
    pr_auc = average_precision_score(y_test, predictions_prob)
    
    print(f"Precision: {precision:.4f} (When it predicts fire, how often is it right?)")
    print(f"Recall:    {recall:.4f} (Out of all actual fires, how many did it catch?)")
    print(f"F1-Score:  {f1:.4f}")
    print(f"PR-AUC:    {pr_auc:.4f} (Primary metric for severe imbalance)")


print("\n--- Final Model Evaluation ---")
predictions_prob = model.predict(X_test)
    
    # Let's test different decision thresholds instead of just 0.5
thresholds = [0.5, 0.75, 0.85, 0.90, 0.95]
    
for thresh in thresholds:
        predictions_binary = (predictions_prob > thresh).astype(int)
        
        precision = precision_score(y_test, predictions_binary, zero_division=0)
        recall = recall_score(y_test, predictions_binary, zero_division=0)
        f1 = f1_score(y_test, predictions_binary, zero_division=0)
        
        print(f"\nThreshold: {thresh}")
        print(f"  Precision: {precision:.4f}")
        print(f"  Recall:    {recall:.4f}")
        print(f"  F1-Score:  {f1:.4f}")
        
pr_auc = average_precision_score(y_test, predictions_prob)
print(f"\nOverall PR-AUC: {pr_auc:.4f}")


import numpy as np
import tensorflow as tf
from tensorflow.keras import layers
from sklearn.metrics import precision_score, recall_score, f1_score, average_precision_score
from sklearn.model_selection import train_test_split

# ==========================================
# 1. Custom Focal Loss Function
# ==========================================
class BinaryFocalLoss(tf.keras.losses.Loss):
    """
    Focal Loss dynamically scales the loss based on prediction confidence.
    It down-weights easy negatives and heavily penalizes missed fires.
    """
    def __init__(self, gamma=2.0, alpha=0.75, **kwargs):
        super().__init__(**kwargs)
        self.gamma = gamma
        self.alpha = alpha # Alpha > 0.5 weights the positive class (Fire) heavier

    def call(self, y_true, y_pred):
        y_true = tf.cast(y_true, tf.float32)
        # Clip probabilities to prevent log(0)
        y_pred = tf.clip_by_value(y_pred, tf.keras.backend.epsilon(), 1.0 - tf.keras.backend.epsilon())
        
        # Calculate p_t (probability of the true class)
        p_t = y_true * y_pred + (1 - y_true) * (1 - y_pred)
        alpha_t = y_true * self.alpha + (1 - y_true) * (1 - self.alpha)
        
        # Focal Loss formula
        loss = -alpha_t * tf.pow(1 - p_t, self.gamma) * tf.math.log(p_t)
        return tf.reduce_mean(loss)

# ==========================================
# 2. Structured "Alaska" Data Generator
# ==========================================
def generate_structured_alaska_data(num_samples=2000, lookback=6, height=16, width=16, channels=5):
    """
    Simulates spatiotemporal data with actual spatial patterns (hotspots)
    so the CNN has geometric features to learn.
    """
    print("Generating structured spatiotemporal tensors...")
    X = np.random.rand(num_samples, lookback, height, width, channels).astype(np.float32) * 0.5
    y = np.zeros((num_samples, 1), dtype=np.float32)
    
    # Intentionally create ~10% actual fire events
    num_fires = int(num_samples * 0.10)
    fire_indices = np.random.choice(num_samples, num_fires, replace=False)
    
    for i in fire_indices:
        y[i] = 1.0
        # Inject a "hotspot" (spatial pattern) in the most recent time steps
        # E.g., a 4x4 grid of extreme weather (High Temp[2], High Wind[3], Low Moisture[1])
        start_h, start_w = np.random.randint(0, height-4), np.random.randint(0, width-4)
        
        for t in range(lookback - 2, lookback): # The last two months get severe
            X[i, t, start_h:start_h+4, start_w:start_w+4, 2] += 0.4 # Spike Temp
            X[i, t, start_h:start_h+4, start_w:start_w+4, 3] += 0.4 # Spike Wind
            X[i, t, start_h:start_h+4, start_w:start_w+4, 1] -= 0.3 # Drop Moisture
            
    # Ensure values stay between 0 and 1
    X = np.clip(X, 0.0, 1.0)
    
    print(f"Dataset generated. Class Distribution: {int(np.sum(y))} Fires, {len(y) - int(np.sum(y))} Non-Fires")
    return X, y

# ==========================================
# 3. Hybrid CNN-Transformer Architecture
# ==========================================
class TransformerEncoderBlock(layers.Layer):
    def __init__(self, embed_dim, num_heads, ff_dim, rate=0.1, **kwargs):
        super(TransformerEncoderBlock, self).__init__(**kwargs)
        self.att = layers.MultiHeadAttention(num_heads=num_heads, key_dim=embed_dim)
        self.ffn = tf.keras.Sequential([
            layers.Dense(ff_dim, activation="relu"),
            layers.Dense(embed_dim)
        ])
        self.layernorm1 = layers.LayerNormalization(epsilon=1e-6)
        self.layernorm2 = layers.LayerNormalization(epsilon=1e-6)
        self.dropout1 = layers.Dropout(rate)
        self.dropout2 = layers.Dropout(rate)

    def call(self, inputs, training=False):
        attn_output = self.att(inputs, inputs)
        attn_output = self.dropout1(attn_output, training=training)
        out1 = self.layernorm1(inputs + attn_output)
        ffn_output = self.ffn(out1)
        ffn_output = self.dropout2(ffn_output, training=training)
        return self.layernorm2(out1 + ffn_output)

def build_hybrid_fire_model(lookback, height, width, channels):
    inputs = layers.Input(shape=(lookback, height, width, channels))
    
    # Added BatchNormalization to stabilize CNN learning
    x = layers.TimeDistributed(layers.Conv2D(16, (3, 3), activation='relu', padding='same'))(inputs)
    x = layers.TimeDistributed(layers.BatchNormalization())(x)
    x = layers.TimeDistributed(layers.MaxPooling2D((2, 2)))(x)
    
    x = layers.TimeDistributed(layers.Conv2D(32, (3, 3), activation='relu', padding='same'))(x)
    x = layers.TimeDistributed(layers.BatchNormalization())(x)
    x = layers.TimeDistributed(layers.GlobalAveragePooling2D())(x)
    
    embed_dim = 32
    positions = tf.range(start=0, limit=lookback, delta=1)
    pos_embeddings = layers.Embedding(input_dim=lookback, output_dim=embed_dim)(positions)
    x = x + pos_embeddings
    
    x = TransformerEncoderBlock(embed_dim=embed_dim, num_heads=4, ff_dim=64)(x)
    x = layers.Lambda(lambda tensor: tensor[:, -1, :])(x)
    
    x = layers.Dense(32, activation="relu")(x)
    x = layers.Dropout(0.3)(x)
    outputs = layers.Dense(1, activation="sigmoid")(x)
    
    return tf.keras.Model(inputs=inputs, outputs=outputs)

# ==========================================
# 4. Execution & Threshold Evaluation
# ==========================================
if __name__ == "__main__":
    LOOKBACK, GRID_SIZE, CHANNELS = 6, 16, 5
    BATCH_SIZE, EPOCHS = 32, 15
    
    X_full, y_full = generate_structured_alaska_data(num_samples=2000)
    X_train, X_test, y_train, y_test = train_test_split(X_full, y_full, test_size=0.2, random_state=42, stratify=y_full)

    model = build_hybrid_fire_model(LOOKBACK, GRID_SIZE, GRID_SIZE, CHANNELS)
    
    # 💥 KEY FIX: Using the Custom Focal Loss and removing class_weights
    model.compile(
        optimizer=tf.keras.optimizers.Adam(learning_rate=1e-3),
        loss=BinaryFocalLoss(gamma=2.0, alpha=0.75), 
        metrics=[tf.keras.metrics.AUC(curve='PR', name='pr_auc'), 'accuracy']
    )
    
    print("\nTraining with Focal Loss...")
    model.fit(X_train, y_train, batch_size=BATCH_SIZE, epochs=EPOCHS, validation_split=0.2, verbose=1)
    
    print("\n--- Final Model Evaluation (Threshold Tuning) ---")
    predictions_prob = model.predict(X_test)
    
    thresholds = [0.3, 0.5, 0.7]
    for thresh in thresholds:
        predictions_binary = (predictions_prob > thresh).astype(int)
        precision = precision_score(y_test, predictions_binary, zero_division=0)
        recall = recall_score(y_test, predictions_binary, zero_division=0)
        f1 = f1_score(y_test, predictions_binary, zero_division=0)
        
        print(f"\nThreshold: {thresh}")
        print(f"  Precision: {precision:.4f}")
        print(f"  Recall:    {recall:.4f}")
        print(f"  F1-Score:  {f1:.4f}")
        
    pr_auc = average_precision_score(y_test, predictions_prob)
    print(f"\nOverall PR-AUC: {pr_auc:.4f}")



